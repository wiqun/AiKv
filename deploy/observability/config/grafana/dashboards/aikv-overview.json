{
  "title": "AiKv / 概览与基准评测 (Overview & Benchmark)",
  "uid": "aikv-overview",
  "tags": [
    "aikv",
    "benchmark",
    "overview"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 38,
  "version": 4,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "query": "label_values(aikv_uptime_seconds, cluster)",
        "definition": "label_values(aikv_uptime_seconds, cluster)",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "refresh": 1,
        "includeAll": true,
        "multi": false,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "query": "label_values(aikv_uptime_seconds{cluster=~\"$cluster\"}, host_name)",
        "definition": "label_values(aikv_uptime_seconds{cluster=~\"$cluster\"}, host_name)",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "refresh": 1,
        "includeAll": true,
        "multi": false,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "query": "label_values(aikv_uptime_seconds{cluster=~\"$cluster\", host_name=~\"$host\"}, service_instance_id)",
        "definition": "label_values(aikv_uptime_seconds{cluster=~\"$cluster\", host_name=~\"$host\"}, service_instance_id)",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "1. 业务黑盒层 (Business Black-Box Layer)",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "id": 2,
      "title": "集群与各节点吞吐趋势 (QPS: Total & aikv-*)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(aikv_commands_total{cluster=~\"$cluster\", host_name=~\"$host\", service_instance_id=~\"$instance\"}[$__rate_interval])) or vector(0)",
          "refId": "A",
          "legendFormat": "【集群总计】"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_instance_id) (rate(aikv_commands_total{cluster=~\"$cluster\", host_name=~\"$host\", service_instance_id=~\"$instance\"}[$__rate_interval]))",
          "refId": "B",
          "legendFormat": "aikv-{{service_instance_id}}"
        }
      ],
      "description": "一张图对比集群总吞吐与各个 aikv 节点各自的实时命令吞吐走势，快速诊断分片负载与流量倾斜。",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "各命令吞吐时序拆解 (QPS by Command)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (aikv_command_name) (rate(aikv_commands_total{cluster=~\"$cluster\", host_name=~\"$host\", service_instance_id=~\"$instance\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{aikv_command_name}}"
        }
      ],
      "description": "各类命令请求吞吐的时序演进趋势，承接左侧吞吐进行具体业务命令级拆解。",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "命令延迟分位数时序 (P50 / P95 / P99)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum(rate(aikv_command_duration_seconds_bucket{cluster=~\"$cluster\", host_name=~\"$host\", service_instance_id=~\"$instance\"}[$__rate_interval])) by (le))",
          "refId": "A",
          "legendFormat": "P50 中位数"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(aikv_command_duration_seconds_bucket{cluster=~\"$cluster\", host_name=~\"$host\", service_instance_id=~\"$instance\"}[$__rate_interval])) by (le))",
          "refId": "B",
          "legendFormat": "P95 尾部延迟"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum(rate(aikv_command_duration_seconds_bucket{cluster=~\"$cluster\", host_name=~\"$host\", service_instance_id=~\"$instance\"}[$__rate_interval])) by (le))",
          "refId": "C",
          "legendFormat": "P99 极端长尾"
        }
      ],
      "description": "中位数与长尾延迟随时间波动的全貌对照 (黄金信号)，对照左侧吞吐评估稳定性。",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "命令调用量占比 (所选时间范围)",
      "type": "piechart",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (aikv_command_name) (increase(aikv_commands_total{cluster=~\"$cluster\", host_name=~\"$host\", service_instance_id=~\"$instance\"}[$__range]))",
          "refId": "A",
          "legendFormat": "{{aikv_command_name}}"
        }
      ],
      "description": "当前时间窗口内各类命令调用量占比构成 (SET/GET/PING/MGET)。",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "percent"
          ]
        }
      }
    },
    {
      "id": 6,
      "title": "键空间命中率趋势 (%)",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 6,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "((sum(rate(aikv_keyspace_hits_total{cluster=~\"$cluster\", host_name=~\"$host\", service_instance_id=~\"$instance\"}[$__rate_interval])) / ((sum(rate(aikv_keyspace_hits_total{cluster=~\"$cluster\", host_name=~\"$host\", service_instance_id=~\"$instance\"}[$__rate_interval])) + sum(rate(aikv_keyspace_misses_total{cluster=~\"$cluster\", host_name=~\"$host\", service_instance_id=~\"$instance\"}[$__rate_interval]))) > 0)) * 100) or vector(100)",
          "refId": "A",
          "legendFormat": "命中率 (Hit Rate %)"
        }
      ],
      "description": "键查找命中率时序波动 (Hits / (Hits + Misses))，直观评估缓存与数据命中效率。",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "100%"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "网络吞吐带宽趋势 (MB/s)",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(aikv_net_input_bytes_total{cluster=~\"$cluster\", host_name=~\"$host\", service_instance_id=~\"$instance\"}[$__rate_interval])) / 1024 / 1024",
          "refId": "A",
          "legendFormat": "入站带宽 (In)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(aikv_net_output_bytes_total{cluster=~\"$cluster\", host_name=~\"$host\", service_instance_id=~\"$instance\"}[$__rate_interval])) / 1024 / 1024",
          "refId": "B",
          "legendFormat": "出站带宽 (Out)"
        }
      ],
      "description": "网络入站与出站物理带宽时序趋势 (一个面板两根线)。",
      "fieldConfig": {
        "defaults": {
          "unit": "MB/s"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "客户端连接与阻塞趋势",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(aikv_connected_clients{cluster=~\"$cluster\", host_name=~\"$host\", service_instance_id=~\"$instance\"})",
          "refId": "A",
          "legendFormat": "活跃客户端数 (Connected)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(aikv_blocked_clients{cluster=~\"$cluster\", host_name=~\"$host\", service_instance_id=~\"$instance\"})",
          "refId": "B",
          "legendFormat": "受阻塞客户端数 (Blocked)"
        }
      ],
      "description": "客户端长连接并发数与受阻塞等待连接数时序趋势 (一个面板两根线)。",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "2. 存储白盒层 (Storage Engine White-Box Layer)",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "collapsed": false
    },
    {
      "id": 10,
      "title": "综合写放大 (WA Ratio)",
      "type": "stat",
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 0,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "((sum(rate(aidb_wal_written_bytes_total{cluster=~\"$cluster\", host_name=~\"$host\", service_instance_id=~\"$instance\"}[$__rate_interval])) + sum(rate(aidb_flush_written_bytes_total{cluster=~\"$cluster\", host_name=~\"$host\", service_instance_id=~\"$instance\"}[$__rate_interval])) + sum(rate(aidb_compaction_written_bytes_total{cluster=~\"$cluster\", host_name=~\"$host\", service_instance_id=~\"$instance\"}[$__rate_interval]))) / (sum(rate(aidb_logical_write_bytes_total{cluster=~\"$cluster\", host_name=~\"$host\", service_instance_id=~\"$instance\"}[$__rate_interval])) > 0)) or vector(0)",
          "refId": "A",
          "legendFormat": "WA Ratio"
        }
      ],
      "description": "写放大 WA = 物理写总字节 / 用户有效逻辑写入字节。",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0.00"
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
    {
      "id": 11,
      "title": "综合读放大 (RA Ratio)",
      "type": "stat",
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 6,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(aidb_block_read_bytes_total{cluster=~\"$cluster\", host_name=~\"$host\", service_instance_id=~\"$instance\"}[$__rate_interval])) / (sum(rate(aidb_logical_read_bytes_total{cluster=~\"$cluster\", host_name=~\"$host\", service_instance_id=~\"$instance\"}[$__rate_interval])) > 0)) or vector(0)",
          "refId": "A",
          "legendFormat": "RA Ratio"
        }
      ],
      "description": "读放大 RA = 从物理介质实际读取字节 / 用户逻辑读取字节。",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0.00"
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
    {
      "id": 12,
      "title": "空间放大 (SA Ratio)",
      "type": "stat",
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 12,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "((sum(aidb_sstable_size_bytes{cluster=~\"$cluster\", host_name=~\"$host\", service_instance_id=~\"$instance\"}) + sum(aidb_wal_size_bytes{cluster=~\"$cluster\", host_name=~\"$host\", service_instance_id=~\"$instance\"})) / (sum(aidb_memtable_size_bytes{cluster=~\"$cluster\", host_name=~\"$host\", service_instance_id=~\"$instance\"}) > 0)) or vector(0)",
          "refId": "A",
          "legendFormat": "SA Ratio"
        }
      ],
      "description": "空间放大 SA = 物理磁盘占用大小 (SST + WAL) / 有效逻辑数据大小。",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0.00"
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
    {
      "id": 13,
      "title": "Compaction 待处理积压 (MB)",
      "type": "stat",
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 18,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(aidb_compaction_pending_bytes{cluster=~\"$cluster\", host_name=~\"$host\", service_instance_id=~\"$instance\"}) / 1024 / 1024) or vector(0)",
          "refId": "A",
          "legendFormat": "Pending Compaction"
        }
      ],
      "description": "LSM-Tree 等待后台压缩合并的数据体积积压。",
      "fieldConfig": {
        "defaults": {
          "unit": "MB",
          "noValue": "0 MB"
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
    {
      "id": 14,
      "title": "物理写入速率分解 (WAL, Flush, Compaction)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(aidb_wal_written_bytes_total{cluster=~\"$cluster\", host_name=~\"$host\", service_instance_id=~\"$instance\"}[$__rate_interval])) / 1024 / 1024",
          "refId": "A",
          "legendFormat": "WAL 物理写入 (MB/s)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(aidb_flush_written_bytes_total{cluster=~\"$cluster\", host_name=~\"$host\", service_instance_id=~\"$instance\"}[$__rate_interval])) / 1024 / 1024",
          "refId": "B",
          "legendFormat": "Flush 刷盘 (MB/s)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(aidb_compaction_written_bytes_total{cluster=~\"$cluster\", host_name=~\"$host\", service_instance_id=~\"$instance\"}[$__rate_interval])) / 1024 / 1024",
          "refId": "C",
          "legendFormat": "Compaction 写入 (MB/s)"
        }
      ],
      "description": "底层各物理写组件的实时写吞吐速率分解。",
      "fieldConfig": {
        "defaults": {
          "unit": "MB/s"
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "title": "Write Stall 写停顿频次与最大耗时",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (aidb_write_stall_cause) (rate(aidb_write_stall_requests_total{cluster=~\"$cluster\", host_name=~\"$host\", service_instance_id=~\"$instance\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "停顿请求/s ({{aidb_write_stall_cause}})"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(aidb_write_stall_max_duration_seconds{cluster=~\"$cluster\", host_name=~\"$host\", service_instance_id=~\"$instance\"})",
          "refId": "B",
          "legendFormat": "单次最大停顿耗时 (s)"
        }
      ],
      "description": "因 MemTable 刷盘不及时或 L0 堆积触发的写限速与写停顿。",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "title": "存储引擎底层 Operation P95 耗时 (s)",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(aidb_operation_duration_seconds_bucket{cluster=~\"$cluster\", host_name=~\"$host\", service_instance_id=~\"$instance\", aidb_operation_name=~\"get|put|delete|write_batch\"}[$__rate_interval])) by (le, aidb_operation_name))",
          "refId": "A",
          "legendFormat": "{{aidb_operation_name}} P95"
        }
      ],
      "description": "存储底层 Put/Get/Delete/WriteBatch 的纯引擎微观 P95 耗时穿透。",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 17,
      "title": "Block Cache 命中率与容量使用率 (%)",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "((sum(rate(aidb_block_cache_hits_total{cluster=~\"$cluster\", host_name=~\"$host\", service_instance_id=~\"$instance\"}[$__rate_interval])) / ((sum(rate(aidb_block_cache_hits_total{cluster=~\"$cluster\", host_name=~\"$host\", service_instance_id=~\"$instance\"}[$__rate_interval])) + sum(rate(aidb_block_cache_misses_total{cluster=~\"$cluster\", host_name=~\"$host\", service_instance_id=~\"$instance\"}[$__rate_interval]))) > 0)) * 100) or vector(0)",
          "refId": "A",
          "legendFormat": "Cache 命中率 (%)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(aidb_block_cache_size_bytes{cluster=~\"$cluster\", host_name=~\"$host\", service_instance_id=~\"$instance\"}) / (sum(aidb_block_cache_capacity_bytes{cluster=~\"$cluster\", host_name=~\"$host\", service_instance_id=~\"$instance\"}) > 0)) * 100 or vector(0)",
          "refId": "B",
          "legendFormat": "Cache 容量使用率 (%)"
        }
      ],
      "description": "Block Cache 读取命中率及 64MB 容量配额的当前占用百分比。",
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
