{
  "title": "总览",
  "uid": "aikv-overview",
  "tags": ["aikv", "overview"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "rate_window",
        "label": "窗口",
        "type": "custom",
        "query": "5m",
        "description": "导出周期大于 75 秒时, 把这个窗口改成至少 4 个导出周期.",
        "current": { "text": "5m", "value": "5m" },
        "options": [{ "text": "5m", "value": "5m", "selected": true }]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "导出新鲜度",
      "description": "导出新鲜度变红: 进程没有在推指标. 这时 /health 仍可能是 200. 导出周期改了就把红线改成两个周期.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 30 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "time() - timestamp(aikv_process_up)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "命令速率",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (status) (rate(aikv_commands_total[$rate_window]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "错误比例",
      "description": "错误比例和延迟一起升, 同时拒绝连接在涨: 看连接看板.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(aikv_commands_total{status=\"error\"}[$rate_window])) / sum(rate(aikv_commands_total[$rate_window]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "命令 P50 / P99",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(aikv_command_duration_seconds_bucket[$rate_window])))",
          "legendFormat": "P50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(aikv_command_duration_seconds_bucket[$rate_window])))",
          "legendFormat": "P99"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "慢查询速率",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(aikv_slowlog_total[$rate_window])"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "点查命中率",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(aikv_point_reads_total{result=\"hit\"}[$rate_window])) / sum(rate(aikv_point_reads_total{result=~\"hit|miss\"}[$rate_window]))"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "连接与拒绝",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(aikv_connections_current)",
          "legendFormat": "current"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(aikv_connections_rejected_total[$rate_window]))",
          "legendFormat": "rejected"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "L0 文件数",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(aidb_l0_files)",
          "legendFormat": "files"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(aidb_l0_compaction_trigger)",
          "legendFormat": "trigger"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(aidb_l0_slowdown_writes_trigger)",
          "legendFormat": "slowdown"
        },
        {
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(aidb_l0_stop_writes_trigger)",
          "legendFormat": "stop"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "写停顿速率",
      "description": "停顿在涨, 并且 L0 越过减速或停写线: 看排障看板上 compaction 的写入字节, 读取字节和最近一次耗时.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (cause, kind) (rate(aidb_write_stall_total[$rate_window]))",
          "legendFormat": "{{cause}} {{kind}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "本周期最大停顿",
      "description": "0 表示这个导出周期没有停顿.",
      "fieldConfig": { "defaults": { "unit": "µs" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(aidb_write_stall_window_max_us)"
        }
      ]
    }
  ]
}
