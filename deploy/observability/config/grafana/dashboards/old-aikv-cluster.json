          "expr": "sum(rate(aikv_commands_total{service_name=\"aikv\",cluster=~\"$cluster\",node_id=~\"$node\",host_name=~\"$host\",aikv_command_name!~\".*\\\\..*\"}[$__rate_interval])) by (aikv_command_name)",
