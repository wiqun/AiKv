        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(aidb_block_cache_misses_total{service_name=\"aikv\",cluster=~\"$cluster\",node_id=~\"$node\",host_name=~\"$host\"}[$__rate_interval])) by (node_id) or (sum by (node_id) (rate(aidb_operations_total{service_name=\"aikv\",cluster=~\"$cluster\",node_id=~\"$node\",host_name=~\"$host\"}[$__rate_interval])) * 0)",
          "legendFormat": "miss/s n{{node_id}}",
          "datasource": {
