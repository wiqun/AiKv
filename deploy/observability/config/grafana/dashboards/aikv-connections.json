{
  "title": "连接",
  "uid": "aikv-connections",
  "tags": ["aikv", "connections"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "rate_window",
        "label": "窗口",
        "type": "custom",
        "query": "5m",
        "description": "导出周期大于 75 秒时, 把这个窗口改成至少 4 个导出周期.",
        "current": { "text": "5m", "value": "5m" },
        "options": [{ "text": "5m", "value": "5m", "selected": true }]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "网络字节",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(aikv_net_input_bytes_total[$rate_window])",
          "legendFormat": "in"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(aikv_net_output_bytes_total[$rate_window])",
          "legendFormat": "out"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "accept 错误",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (errno) (rate(aikv_accept_errors_total[$rate_window]))",
          "legendFormat": "{{errno}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "关闭原因",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (reason) (rate(aikv_connection_closes_total[$rate_window]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "SCAN 扫描量",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(aikv_scan_entries_total[$rate_window])"
        }
      ]
    }
  ]
}
