# AiKv
# AIKV_IMAGE=aikv:dev

# 网络监听绑定地址
PROMETHEUS_BIND=0.0.0.0:9090
GRAFANA_BIND=0.0.0.0:3000
OTEL_GRPC_BIND=0.0.0.0:4317
OTEL_HTTP_BIND=0.0.0.0:4318
NODE_EXPORTER_BIND=0.0.0.0:9100
CADVISOR_BIND=0.0.0.0:8080

## OTel 收集器端点
# AIKV_OTLP_ENDPOINT=http://aikv-otel-collector:4317

## Grafana 安全设置
# GRAFANA_ADMIN_PASSWORD=admin
# GRAFANA_ANONYMOUS=true

## Prometheus 数据保留时长
# PROMETHEUS_RETENTION=7d
# PROMETHEUS_RETENTION_SIZE=10GB

# Resources Limit
# 如需关闭限制或绑核, 将对应变量值设为空即可
# 例如 AIKV_SINGLE_CPUSET=

## AiKv Memory
# AIKV_MEM_LIMIT=2G
# AIKV_MEM_RESERVATION=512M

## AiKv Single
# AIKV_SINGLE_CPUSET=0,1

## AiKv Cluster
# AIKV_NODE1_CPUSET=0,1
# AIKV_NODE2_CPUSET=2,3
# AIKV_NODE3_CPUSET=4,5
# AIKV_NODE4_CPUSET=6,7
# AIKV_NODE5_CPUSET=8,9
# AIKV_NODE6_CPUSET=10,11

## Observability
# OTEL_CPU_LIMIT=1.0
# OTEL_MEM_LIMIT=256M
# PROMETHEUS_CPU_LIMIT=1.0
# PROMETHEUS_MEM_LIMIT=512M
# GRAFANA_CPU_LIMIT=1.0
# GRAFANA_MEM_LIMIT=512M
# NODE_EXPORTER_CPU_LIMIT=0.2
# NODE_EXPORTER_MEM_LIMIT=64M
# CADVISOR_CPU_LIMIT=0.5
# CADVISOR_MEM_LIMIT=128M
